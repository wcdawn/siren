#nx 10
#dx 10. 10. 10. 10. 10. 10. 10. 10. 10. 10.
#mat_map FUEL FUEL FUEL FUEL FUEL FUEL FUEL FUEL REFL REFL

nx 7
dx 30. 10. 10. 10. 10. 10. 20
mat_map FUEL FUEL FUEL FUEL FUEL FUEL REFL

xslib_fname tworeg.xs
refine 8
k_tol 1d-10
